+    /// Limits application-owned pending destinations to about 128 MiB,
+    /// excluding decoder/encoder internals and the shared accumulation target.
+    /// A single very large frame is still allowed; resolution is never reduced.
+    static func depth(width: Int, height: Int) -> Int {
+        resolvedDepth(requested: depth, width: width, height: height)
+    }
+
+    static func resolvedDepth(requested: Int, width: Int, height: Int) -> Int {
+        let budget = 128 * 1024 * 1024
+        guard width > 0, height > 0 else { return 1 }
+        let (pixels, pixelOverflow) = width.multipliedReportingOverflow(by: height)
+        let (bytes, byteOverflow) = pixels.multipliedReportingOverflow(by: 4)
+        guard !pixelOverflow, !byteOverflow, bytes > 0 else { return 1 }
+        return min(3, max(1, requested), max(1, budget / bytes))
+    }
