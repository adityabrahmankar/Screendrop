+/// UI progress is not a frame clock. Keep fast exports from enqueueing a
+/// main-actor task for every few frames; final completion is reported separately.
+nonisolated struct StudioExportProgressGate {
+    private var lastTime = -Double.infinity
+    private var lastProgress = -Double.infinity
+
+    mutating func shouldReport(_ progress: Double, at time: TimeInterval) -> Bool {
+        guard progress.isFinite, time.isFinite, progress > lastProgress,
+              time - lastTime >= 0.1 else { return false }
+        lastTime = time
+        lastProgress = progress
+        return true
+    }
+}
