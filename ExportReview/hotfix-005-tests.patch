+/// Streams the exact uncompressed audio submitted to AAC. Container padding
+/// may differ, but editing, replacement timing and PCM content must not.
+nonisolated final class StudioExportAudioProbe {
+    private let url: URL
+    private var hash = SHA256()
+    private var sampleCount: Int64 = 0
+    private var byteCount: Int64 = 0
+    private var firstTime: CMTime?
+    private var lastEnd = CMTime.zero
+
+    static func make() throws -> StudioExportAudioProbe? {
+        guard let path = ProcessInfo.processInfo.environment["SCREENDROP_STUDIO_EXPORT_AUDIO_DIGEST"], !path.isEmpty else { return nil }
+        return StudioExportAudioProbe(url: URL(fileURLWithPath: path))
+    }
+    private init(url: URL) { self.url = url }
+    func record(_ sample: CMSampleBuffer) throws {
+        guard let block = CMSampleBufferGetDataBuffer(sample) else {
+            throw NSError(domain: "ExportReview.Audio", code: 1)
+        }
+        let count = CMBlockBufferGetDataLength(block)
+        var bytes = Data(count: count)
+        if count > 0 {
+            let status = bytes.withUnsafeMutableBytes { raw -> OSStatus in
+                guard let base = raw.baseAddress else { return -1 }
+                return CMBlockBufferCopyDataBytes(block, atOffset: 0, dataLength: count, destination: base)
+            }
+            guard status == kCMBlockBufferNoErr else { throw NSError(domain: "ExportReview.Audio", code: Int(status)) }
+        }
+        hash.update(data: bytes)
+        byteCount += Int64(count)
+        sampleCount += Int64(CMSampleBufferGetNumSamples(sample))
+        let time = CMSampleBufferGetPresentationTimeStamp(sample)
+        if firstTime == nil { firstTime = time }
+        lastEnd = CMTimeAdd(time, CMSampleBufferGetDuration(sample))
+    }
+    func finish() throws {
+        let result: [String: Any] = ["sha256": hash.finalize().map { String(format: "%02x", $0) }.joined(),
+                                   "samples": sampleCount, "bytes": byteCount,
+                                   "first_seconds": firstTime?.seconds ?? 0, "end_seconds": lastEnd.seconds]
+        try JSONSerialization.data(withJSONObject: result, options: [.sortedKeys, .prettyPrinted]).write(to: url)
+    }
+}
+
+/// Faults exist only in DEBUG/validation builds and require explicit opt-in.
+/// They exercise sibling wakeup and cleanup after the real writer has started.
+nonisolated enum StudioExportReviewFault {
+    static func shouldFail(_ stage: String, ordinal: Int) -> Bool {
+        ordinal >= 5 && ProcessInfo.processInfo.environment["SCREENDROP_EXPORT_REVIEW_FAULT"] == stage
+    }
+    static func check(_ stage: String, ordinal: Int) throws {
+        if shouldFail(stage, ordinal: ordinal) {
+            throw NSError(domain: "ExportReview.Injected", code: 5,
+                          userInfo: [NSLocalizedDescriptionKey: "Injected \(stage) pump failure"])
+        }
+    }
+}
