+def retimed_audio_checks(old: Path, new: Path, reference: dict, actual: dict) -> dict:
+    """Structural/signal regression checks, NOT a claim of waveform equality.
+
+    Pass1 itself is not bit-repeatable near retiming boundaries. Exact equality
+    still gates unretimed and replacement audio; retimed sample differences are
+    retained as an explicit limitation rather than blessed by a hash allowlist.
+    """
+    for key in ('format', 'plane_channels', 'range_start', 'range_end'):
+        assert actual[key] == reference[key], f'retimed audio {key} changed'
+    fmt = actual['format']
+    assert fmt == dict(bits=32, bytes_per_frame=8, channels=2, flags=9, rate=48000), 'unexpected fixture PCM format'
+    rate, channels = 48000, 2
+    expected = round((actual['range_end'] - actual['range_start']) * rate)
+    assert abs(actual['samples'] - expected) <= 96, 'retimed audio endpoint differs by more than 2 ms'
+    assert actual['clock_runs'] == [[0, actual['samples']]], 'retimed audio has a gap or timestamp discontinuity'
+    assert actual['bytes'] == actual['samples'] * 8, 'retimed PCM length mismatch'
+    source_bytes = (old / 'audio.plane0.pcm').read_bytes()
+    output_bytes = (new / 'audio.plane0.pcm').read_bytes()
+    # The fixture's first segment is unretimed. Exclude the transition's DSP
+    # support window, but require exact PCM over its first 1.8 seconds.
+    prefix_bytes = int(1.8 * rate) * 8
+    assert output_bytes[:prefix_bytes] == source_bytes[:prefix_bytes], 'unretimed prefix PCM changed'
+    output = array.array('f')
+    output.frombytes(output_bytes)
+    if sys.byteorder != 'little': output.byteswap()
+    assert all(math.isfinite(x) and abs(x) <= 1 for x in output), 'nonfinite or clipped PCM'
+    assert output[::2] == output[1::2], 'generated stereo channels diverged'
+    mono = output[::channels]
+    windows = []
+    for start, end in ((0.3, 1.7), (2.2, 2.45)):
+        samples = mono[round(start * rate):round(end * rate)]
+        assert len(samples) == round((end-start) * rate), 'missing steady-state audio'
+        crossings = [i for i in range(1, len(samples)) if samples[i-1] < 0 <= samples[i]]
+        assert len(crossings) >= 2, 'silent or invalid tone'
+        hz = (len(crossings)-1) * rate / (crossings[-1]-crossings[0])
+        rms = math.sqrt(sum(x*x for x in samples) / len(samples))
+        assert 438 <= hz <= 442, f'440 Hz fixture pitch changed: {hz}'
+        assert 0.16 <= rms <= 0.185, f'fixture loudness changed: {rms}'
+        windows.append(dict(start=start, end=end, frequency_hz=hz, rms=rms))
+    return dict(exact_unretimed_prefix_seconds=1.8, endpoint_error_samples=actual['samples']-expected,
+                contiguous_sample_clock=True, signal_windows=windows,
+                limitation='Retiming-boundary waveform equality is not established; listening/physical acceptance remains open')
+
